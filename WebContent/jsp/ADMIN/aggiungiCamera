<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="it.unisa.model.Admin, java.util.Map" %>
<%
    Admin admin = (Admin) session.getAttribute("admin");
    if (admin == null) { response.sendRedirect(request.getContextPath() + "/jsp/ACCEDI/Login.jsp"); return; }
    Map<Integer, String> cittaList = (Map<Integer, String>) request.getAttribute("cittaList");
%>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aggiungi B&B</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="<%= request.getContextPath() %>/css/aggiungiCamera.css">
</head>
<body>

<h2>Aggiungi nuovo B&B</h2>

<form action="<%= request.getContextPath() %>/admin/aggiungiCamera" method="post" enctype="multipart/form-data">

    <label for="idCitta">Città
        <select id="idCitta" name="idCitta" required>
            <option value="" disabled selected>Seleziona una città</option>
            <% if (cittaList != null) {
                for (Map.Entry<Integer, String> entry : cittaList.entrySet()) { %>
            <option value="<%= entry.getKey() %>"><%= entry.getValue() %></option>
            <% } } %>
        </select>
    </label>

    <label for="nome">Nome B&B
        <input type="text" id="nome" name="nome" required maxlength="100" placeholder="Es. B&B Vista Mare">
    </label>

    <label for="descrizione">Descrizione
        <textarea id="descrizione" name="descrizione" rows="4" placeholder="Es. Camera Matrimoniale con vista, Camera tripla con balcone"></textarea>
    </label>

    <label for="extra">Extra
        <input type="text" id="extra" name="extra" maxlength="255" placeholder="Es. Wi-Fi gratuito, Colazione inclusa">
    </label>

    <label for="prezzo">Prezzo/notte (€)
        <input type="number" id="prezzo" name="prezzo" step="0.01" min="0" required>
    </label>

    <label for="immagini">Immagini
        <input type="file" id="immagini" name="immagini" accept="image/*" multiple>
    </label>

    <button type="submit">Aggiungi B&B</button>

    <a href="<%= request.getContextPath() %>/admin/camere" class="torna-indietro">← Torna alla lista</a>

</form>
</body>
</html>
